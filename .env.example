# Sanity CMS — content is fetched via GROQ directly in component frontmatter.
# Leave unset to fall back to the static copy baked into each page.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Resend — transactional email for the contact form (src/pages/api/contact.ts)
RESEND_API_KEY=
CONTACT_TO_EMAIL=czesc@auraflux.pl

# Notion — lead log for the contact form (src/pages/api/contact.ts)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Mailerlite — newsletter + lead-magnet subscriptions
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Cloudflare Turnstile — bot protection on the contact form
TURNSTILE_SECRET_KEY=
