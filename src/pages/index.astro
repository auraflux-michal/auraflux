---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BrandsStrip from '../components/BrandsStrip.astro';
import StatsRow from '../components/StatsRow.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import ServicesDark from '../components/ServicesDark.astro';
import TestimonialsGrid from '../components/TestimonialsGrid.astro';
import Process from '../components/Process.astro';
import TeamSection from '../components/TeamSection.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import FAQ from '../components/FAQ.astro';
import ContactSection from '../components/ContactSection.astro';
import { safeFetch } from '../lib/sanity';

const query = `*[_type == "homePage"][0]{
  services[]{num, name, desc, href},
  testimonial{quote, name, handle},
  faq[]{q, a}
}`;

const fallback = {
  services: [
    {
      num: '01',
      name: 'Strategia',
      desc: 'Zanim zaprojektujemy cokolwiek, układamy DNA marki: kim jesteś, do kogo mówisz i dokąd zmierzasz. Warsztaty, analiza rynku i konkurencji, mapowanie person klientów.',
      href: '/partnerstwo-strategiczne',
    },
    {
      num: '02',
      name: 'Tworzenie brandingu',
      desc: 'Budujemy tożsamość, która oddaje to, kim naprawdę jesteś — identyfikacja wizualna, ton komunikacji, spójność na każdym punkcie styku z marką.',
      href: '/branding',
    },
    {
      num: '03',
      name: 'Strony internetowe i UX/UI',
      desc: 'Strona to nie wizytówka — to maszyna sprzedażowa. Projektujemy pod konwersję: intuicyjna ścieżka użytkownika, szybkość, design w pełnej zgodzie z marką.',
      href: '/strony-www',
    },
    {
      num: '04',
      name: 'Marketing i widoczność',
      desc: 'Regularna obecność marki tam, gdzie są Twoi klienci — social media, kampanie Meta Ads, newslettery sprzedażowe. Spójnie, konsekwentnie, z myślą o długim biegu.',
      href: '/partnerstwo-strategiczne',
    },
    {
      num: '05',
      name: 'Opieka technologiczna',
      desc: 'Hosting, domeny, aktualizacje, bezpieczeństwo, SSL, backupy, RODO — pilnujemy zaplecza, żeby projekt działał bez przerw. A gdy przychodzi czas na skalowanie: integracje i nowe funkcje.',
      href: '/opieka-technologiczna',
    },
  ],
  testimonial: {
    quote: 'Z perspektywy czasu mogę dodać, że współpraca przebiegała znakomicie dzięki profesjonalizmowi, kreatywności i skupieniu na kliencie. Efekt końcowy jest odzwierciedleniem tych cech — dziękuję!',
    name: 'Krzysztof Wnęk',
    handle: '@pozytywnainteligencja',
  },
  faq: [
    {
      q: 'Ile kosztuje budowa strony internetowej lub branding?',
      a: 'Każdy projekt wyceniamy indywidualnie po krótkim brieffie i rozmowie. Strona internetowa zaczyna się od ok. 12 000 zł, kompleksowy branding — od 8 000 zł. Po pierwszej rozmowie wysyłamy konkretny zakres i widełki cenowe.',
    },
    {
      q: 'Jak długo trwa wdrożenie usług, np. strony czy opieki tech?',
      a: 'Standardowo strona internetowa to 6–10 tygodni, branding 4–6 tygodni, a opiekę techniczną przejmujemy w 5 dni roboczych. Harmonogram zawsze ustalamy razem na start projektu.',
    },
    {
      q: 'Czy obsługujecie tylko duże projekty, czy też małych twórców?',
      a: 'Pracujemy zarówno ze scale-upami, jak i z jednoosobowymi działalnościami i twórcami. Najważniejsza dla nas jest spójność wizji — wielkość firmy ma znaczenie drugorzędne.',
    },
    {
      q: 'Co z bezpieczeństwem danych i aktualizacjami?',
      a: 'W ramach opieki technologicznej dbamy o backupy, certyfikaty SSL, aktualizacje CMS-a, monitoring uptime i regularne audyty bezpieczeństwa. Wszystko raportujemy w comiesięcznym podsumowaniu.',
    },
    {
      q: 'Jak mierzycie sukces i generujecie referencje?',
      a: 'Sukces mierzymy realnymi wskaźnikami — konwersją, ruchem organicznym, czasem na stronie i opinią klientów. Po wdrożeniu prosimy o krótką ankietę NPS i, jeśli zechcesz, referencję wideo.',
    },
  ],
};

const data = await safeFetch(query, fallback);
---

<Layout
  title="auraflux — design. wdrożenie. opieka."
  description="Budujemy marki, które mają w sobie coś żywego — energię, odwagę i kierunek. Strategia, branding, strony, marketing i opieka techniczna."
  active="start"
>
  <Hero />
  <BrandsStrip />
  <StatsRow />
  <ProjectsGrid
    tall={[
      { title: 'Abelard Olza', sub: '2026 · Strategia · Strona internetowa', href: '/case-study', bg: '#eeeae3' },
      { title: 'Pozytywna Inteligencja', sub: '2024 · Strategia · Landing page', href: '/case-study', bg: '#bfe3c4' },
    ]}
    row={{ title: 'Ask Spot', sub: '2024 · Chatbot · Landing page', href: '/case-study', bg: '#dad6cd' }}
  />
  <ServicesDark services={data.services} />
  <TestimonialsGrid main={data.testimonial} />
  <Process />
  <TeamSection />
  <LeadMagnet
    heading="Zanim zlecisz stronę —"
    headingItalic="12 rzeczy"
    headingRest="które musisz wiedzieć"
    paragraph="Praktyczny PDF, który przeprowadzi Cię przez briefing, budżet i pułapki współpracy z agencją. Oszczędź tygodnie i tysiące złotych jeszcze przed startem projektu."
    bullets={['Checklista briefu na 1 stronę A4', 'Realne widełki budżetów 2026', '7 pytań, które rozbroją każdą agencję']}
  />
  <FAQ items={data.faq} />
  <ContactSection
    linkText="Napisz do nas"
    rest="Pokażemy, jak odciążyć Cię w technologii i strategii, aby Twój biznes działał bez zakłóceń."
  />
</Layout>
