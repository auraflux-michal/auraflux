---
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  reverse?: boolean;
  imageLabel: string;
  heading: string;
  paragraph: string;
  items: string[];
}
const { reverse = false, imageLabel, heading, paragraph, items } = Astro.props;
---

<div class={`grid items-center gap-[30px] py-[46px] min-[981px]:grid-cols-2 min-[981px]:gap-16 ${reverse ? '' : ''}`}>
  <div class={reverse ? 'order-1 min-[981px]:order-2' : 'order-1'}>
    <PlaceholderImage label={imageLabel} class="h-[clamp(280px,34vw,440px)] w-full" bg="#eeeae3" />
  </div>
  <div class={reverse ? 'order-2 min-[981px]:order-1' : 'order-2'}>
    <h3 class="mb-[22px] font-sans text-[clamp(28px,3.4vw,40px)] font-medium leading-[1.05] tracking-[-0.025em] text-ink">{heading}</h3>
    <p class="mb-4 max-w-[460px] font-body text-base leading-[1.6] text-ink-2">{paragraph}</p>
    <ul class="mt-6 flex flex-col gap-[14px]">
      {items.map((item) => (
        <li class="flex items-baseline gap-[14px] border-t border-line pt-[14px] font-sans text-[15px] text-ink before:text-ink-3 before:content-['→']">{item}</li>
      ))}
    </ul>
  </div>
</div>
