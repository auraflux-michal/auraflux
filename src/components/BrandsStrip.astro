---
const brands = ['Abelard Olza', 'Pozytywna Inteligencja', 'Ask Spot', 'Studio Forma', 'Nord Digital', 'Lauro Home'];
---

<section class="py-16 overflow-hidden border-b border-line">
  <p class="wrap mb-8 font-body text-[12px] uppercase tracking-[0.12em] text-ink-3">zaufały nam</p>
  <div class="relative">
    <div class="marquee-track marquee-slow select-none">
      {[...brands, ...brands].map((name) => (
        <span class="inline-flex items-center gap-10 px-10">
          <span class="font-sans text-[15px] font-medium tracking-[-0.01em] text-ink-2 opacity-40 transition-opacity hover:opacity-100">{name}</span>
          <span class="h-[1px] w-[40px] bg-line"></span>
        </span>
      ))}
    </div>
  </div>
</section>
