---
import PlaceholderImage from './PlaceholderImage.astro';

const logos = [1, 2, 3, 4, 5, 6];
---

<section class="wrap pb-[90px] pt-[30px]">
  <div class="mb-7 font-body text-[13px] text-ink-3">zaufały nam takie marki jak</div>
  <div class="grid grid-cols-3 items-center gap-x-6 gap-y-8 min-[981px]:grid-cols-6 min-[981px]:gap-y-6">
    {logos.map((n) => (
      <PlaceholderImage label={`Logo ${n}`} class="h-[56px] w-full" bg="#f6f6f4" />
    ))}
  </div>
</section>
