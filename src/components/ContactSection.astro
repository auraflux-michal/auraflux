---
interface Props {
  linkText: string;
  rest: string;
}
const { linkText, rest } = Astro.props;
---

<section id="kontakt" class="bg-dark py-[140px]">
  <div class="wrap">
    <p class="mb-10 font-body text-[12px] uppercase tracking-[0.12em] text-white/30">kontakt</p>

    <div class="grid items-end gap-12 min-[981px]:grid-cols-[1fr_auto] min-[981px]:gap-24">
      <div>
        <h2 class="reveal m-0 font-sans text-[clamp(44px,6.5vw,96px)] font-medium leading-[0.97] tracking-[-0.04em] text-white">
          Twój kolejny<br />rozdział zaczyna<br />
          <span class="font-serif font-normal italic text-white/60">się tutaj.</span>
        </h2>
      </div>

      <div class="reveal delay-2 flex flex-col gap-4 min-[981px]:pb-2">
        <a
          href="mailto:czesc@auraflux.pl"
          class="inline-flex h-[56px] items-center gap-3 rounded-full bg-white px-8 font-sans text-[15px] font-semibold text-dark transition-[background,transform] hover:-translate-y-[2px] hover:bg-white/90"
        >
          {linkText} ↗
        </a>
        <a
          href="tel:+48000000000"
          class="inline-flex h-[56px] items-center gap-3 justify-center rounded-full border border-white/15 px-8 font-sans text-[15px] text-white/60 transition-colors hover:border-white/30 hover:text-white"
        >
          lub zadzwoń
        </a>
      </div>
    </div>

    <p class="reveal delay-3 mt-14 max-w-[480px] font-body text-[15px] leading-[1.65] text-white/35">
      {rest}
    </p>
  </div>
</section>
