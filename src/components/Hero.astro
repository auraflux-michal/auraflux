---
---

<section id="start" class="relative flex min-h-[100svh] flex-col overflow-hidden bg-dark">
  <!-- subtle noise texture overlay -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.03]"
    style="background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\"); background-size: 180px;">
  </div>
  <!-- glow orbs -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="orb-1 absolute -left-[20%] top-[-5%] h-[700px] w-[700px] rounded-full bg-[radial-gradient(circle,rgba(180,138,120,0.12)_0%,transparent_65%)]"></div>
    <div class="orb-2 absolute -right-[10%] bottom-[10%] h-[600px] w-[600px] rounded-full bg-[radial-gradient(circle,rgba(107,91,78,0.1)_0%,transparent_65%)]"></div>
  </div>

  <!-- main grid -->
  <div class="wrap relative flex flex-1 flex-col justify-center py-[120px]">
    <div class="grid items-start gap-8 min-[981px]:grid-cols-[1fr_360px] min-[981px]:gap-16">

      <!-- left: big headline -->
      <div>
        <!-- eyebrow -->
        <div class="reveal mb-10 flex items-center gap-3">
          <div class="h-[1px] w-10 bg-white/20"></div>
          <span class="font-body text-[11px] uppercase tracking-[0.2em] text-white/40">Studio kreatywne · Warszawa</span>
        </div>

        <h1 class="m-0 font-sans font-medium leading-[0.9] tracking-[-0.045em]">
          <span class="reveal overflow-hidden block">
            <span class="block text-[clamp(72px,11.5vw,172px)] text-white">design<span class="text-white/25">.</span></span>
          </span>
          <span class="reveal delay-1 overflow-hidden block">
            <span class="block text-[clamp(72px,11.5vw,172px)] text-white">wdrożenie<span class="text-white/25">.</span></span>
          </span>
          <span class="reveal delay-2 overflow-hidden block">
            <span class="block font-serif font-normal italic tracking-[-0.025em] text-[clamp(68px,11vw,165px)] text-white/70">opieka.</span>
          </span>
        </h1>
      </div>

      <!-- right: desc + CTA -->
      <div class="reveal delay-3 flex flex-col justify-between gap-10 min-[981px]:pt-[110px]">
        <p class="font-body text-[16px] leading-[1.6] text-white/55">
          Budujemy marki, które mają w sobie coś żywego — energię, odwagę i kierunek. Ty skupiasz się na wizji, my pilnujemy reszty.
        </p>

        <div class="flex flex-col gap-4">
          <a href="#kontakt" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-full bg-white px-7 font-sans text-[14px] font-semibold text-dark transition-[background,transform] hover:-translate-y-[2px] hover:bg-white/90">
            Umów konsultację ↗
          </a>
          <a href="#uslugi" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-full border border-white/15 px-7 font-sans text-[14px] text-white/60 transition-colors hover:border-white/30 hover:text-white">
            Zobacz usługi ↓
          </a>
        </div>

        <!-- social proof badge -->
        <div class="flex items-center gap-3 rounded-[10px] border border-white/10 bg-white/[0.04] px-4 py-3">
          <div class="flex shrink-0 [&>span:not(:first-child)]:-ml-2">
            <span class="h-8 w-8 rounded-full border border-white/20 bg-[linear-gradient(135deg,#7a6a5a,#3b2f28)]"></span>
            <span class="h-8 w-8 rounded-full border border-white/20 bg-[linear-gradient(135deg,#c4a48a,#6e5240)]"></span>
            <span class="h-8 w-8 rounded-full border border-white/20 bg-[linear-gradient(135deg,#9a8a78,#4a3e34)]"></span>
          </div>
          <div class="font-body text-[12px] leading-[1.4] text-white/40">
            <b class="block font-semibold text-white/70">90+ klientów</b>we wspólnocie auraflux
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- bottom marquee -->
  <div class="relative overflow-hidden border-t border-white/[0.08] py-5">
    <div class="marquee-track select-none">
      {['Strategia', 'Branding', 'Strony WWW', 'UX/UI', 'Meta Ads', 'Copywriting', 'Opieka Tech', 'AI First', 'Strategia', 'Branding', 'Strony WWW', 'UX/UI', 'Meta Ads', 'Copywriting', 'Opieka Tech', 'AI First'].map((item) => (
        <span class="inline-flex items-center gap-5 px-5 font-body text-[11px] uppercase tracking-[0.14em] text-white/25">
          {item} <span class="text-[#b48a78]/60">·</span>
        </span>
      ))}
    </div>
  </div>
</section>
