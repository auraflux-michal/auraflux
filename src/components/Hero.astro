---
// src/components/Hero.astro
//
// Hero strony głównej — odwzorowanie sekcji "section_hero" z Figmy
// (plik auraflux, node 654:1090). Zdjęcie tła z przyciemnieniem, nagłówek,
// lead, karta kontaktowa i social proof. Nawigacja nie jest tu duplikowana —
// obsługuje ją globalny <Nav /> renderowany przez Layout.astro.
//
// UWAGA — placeholdery: eksport z Figmy (Dev Mode MCP) zdążył pobrać tylko
// tymczasowe zastępniki dla `background.png`, `michal-caba.png` i awatarów —
// sesja lokalnego serwera MCP wygasła zanim ściągnęła docelowe pliki.
// Podmień je w `public/images/hero/` na realne zdjęcia przed publikacją.

const imgHeroBackground = '/images/hero/background.png';
const imgMichalCaba = '/images/hero/michal-caba.png';
const avatars = [
  '/images/hero/avatar-1.png',
  '/images/hero/avatar-2.png',
  '/images/hero/avatar-3.png',
  '/images/hero/avatar-4.png',
];
---

<section id="start" class="relative flex min-h-[100svh] flex-col overflow-hidden bg-dark">
  <!-- background photo + dark overlay -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img src={imgHeroBackground} alt="" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-dark/60"></div>
  </div>

  <!-- headline + lead + contact card -->
  <div class="wrap relative flex flex-1 flex-col justify-center py-28">
    <div class="grid items-start gap-10 min-[981px]:grid-cols-[1fr_440px] min-[981px]:gap-16">
      <h1 class="reveal m-0 max-w-[540px] font-sans text-[clamp(40px,7vw,72px)] font-extrabold leading-[1.1] tracking-[-0.01em] text-cream">
        Technologia<br />w aurze<br />Twojej wizji.
      </h1>

      <div class="reveal delay-1 flex flex-col gap-8 min-[981px]:pt-6">
        <p class="max-w-[440px] font-body text-xl leading-[1.7] text-cream/90">
          Budujemy marki, które mają w sobie coś żywego — energię, odwagę i
          kierunek. Ty skupiasz się na wizji, my pilnujemy reszty.
        </p>

        <div class="flex w-full max-w-[440px] gap-3 rounded-xl bg-white p-3">
          <img
            src={imgMichalCaba}
            alt="Michał Caba — Founder &amp; Art Director w Auraflux"
            width="148"
            height="184"
            class="h-[168px] w-[132px] shrink-0 rounded-lg object-cover"
          />
          <div class="flex flex-col justify-center gap-4 py-1">
            <div>
              <p class="font-sans text-xl font-semibold leading-[1.3] text-dark">Michał Caba</p>
              <p class="mt-1 font-body text-[15px] leading-[1.5] text-dark/64">
                Founder &amp; Art Director<br />w Auraflux
              </p>
            </div>
            <a
              href="/#kontakt"
              class="inline-flex w-fit items-center justify-center gap-2 rounded-lg bg-dark px-6 py-3 font-sans text-[13px] font-semibold uppercase tracking-wide text-cream transition-[background,transform] hover:-translate-y-px hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dark"
            >
              porozmawiajmy
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
                <path d="M7 17L17 7M8 7H17V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- social proof -->
  <div class="reveal delay-2 wrap relative flex items-center gap-4 pb-16 pt-6">
    <div class="flex shrink-0 [&>img:not(:first-child)]:-ml-3">
      {avatars.map((src) => (
        <img src={src} alt="" width="48" height="48" class="h-12 w-12 rounded-full border-2 border-dark object-cover" />
      ))}
    </div>
    <p class="font-body text-base leading-[1.4] text-cream">
      <b class="block font-semibold">90+ Klientów</b>
      <span class="text-cream/60">we wspólnocie auraflux</span>
    </p>
  </div>
</section>
