---
import LinkUl from './LinkUl.astro';
---

<section id="start" class="wrap pb-[100px] pt-[84px]">
  <div class="grid items-start gap-10 min-[981px]:grid-cols-[1.35fr_0.9fr] min-[981px]:gap-20">
    <h1 class="m-0 font-sans text-[clamp(72px,11vw,168px)] font-medium leading-[0.95] tracking-[-0.045em] text-ink">
      <span class="block">trans&shy;for&shy;macja<span class="text-ink">.</span></span>
      <span class="block">zaufanie<span class="text-ink">.</span></span>
      <span class="block font-serif font-normal italic tracking-[-0.02em]">odciążenie</span>
    </h1>
    <div class="flex max-w-none flex-col gap-9 pt-[14px] min-[981px]:ml-auto min-[981px]:max-w-[360px]">
      <p class="max-w-[340px] font-body text-[17px] leading-[1.55] text-ink-2">
        Nie jesteśmy agencją od zamówień. Jesteśmy partnerem strategicznym — wchodzimy głęboko, bierzemy na siebie technologię i marketing, a Ty skupiasz się na tym, co naprawdę ważne.
      </p>
      <LinkUl href="#dla-kogo" arrow="↓">sprawdź, czy to dla Ciebie</LinkUl>
      <div class="flex items-center gap-[14px]">
        <div class="flex [&>span:not(:first-child)]:-ml-2">
          <span class="h-[38px] w-[38px] rounded-full border-2 border-white bg-[linear-gradient(135deg,#7a6a5a,#3b2f28)] shadow-[0_0_0_1px_rgba(0,0,0,0.05)]"></span>
          <span class="h-[38px] w-[38px] rounded-full border-2 border-white bg-[linear-gradient(135deg,#c4a48a,#6e5240)] shadow-[0_0_0_1px_rgba(0,0,0,0.05)]"></span>
          <span class="h-[38px] w-[38px] rounded-full border-2 border-white bg-[linear-gradient(135deg,#9a8a78,#4a3e34)] shadow-[0_0_0_1px_rgba(0,0,0,0.05)]"></span>
        </div>
        <div class="font-body text-[13px] leading-[1.35] text-ink-2">
          <b class="block font-semibold text-ink">90+ partnerów</b>którym oddaliśmy spokój
        </div>
      </div>
    </div>
  </div>
</section>
