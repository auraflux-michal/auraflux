---
interface Tier {
  pk: string;
  amt: string;
  unit?: string;
  pd: string;
  items: string[];
  buyText: string;
  featured?: boolean;
}
interface Props {
  tiers: Tier[];
}
const { tiers } = Astro.props;
---

<div class="mt-[52px] grid grid-cols-1 gap-6 min-[981px]:grid-cols-3">
  {tiers.map((t) => (
    <div class={`flex flex-col rounded-[6px] border p-[30px] py-[34px] transition-[border-color,box-shadow] ${
      t.featured
        ? 'border-dark bg-dark text-white'
        : 'border-line bg-white hover:border-line-2 hover:shadow-[0_4px_16px_rgba(0,0,0,0.06)]'
    }`}>
      <div class={`font-body text-[13px] uppercase tracking-[0.04em] ${t.featured ? 'text-white/70' : 'text-ink-3'}`}>{t.pk}</div>
      <div class={`mt-[18px] mb-1 font-sans text-[42px] font-medium leading-none tracking-[-0.03em] ${t.featured ? 'text-white' : 'text-ink'}`}>
        {t.amt}{t.unit && <small class={`text-[15px] font-normal ${t.featured ? 'text-white/70' : 'text-ink-3'}`}> {t.unit}</small>}
      </div>
      <div class={`mb-6 mt-[6px] font-body text-sm leading-[1.55] ${t.featured ? 'text-white/85' : 'text-ink-2'}`}>{t.pd}</div>
      <ul class="mb-7 flex flex-col gap-[13px]">
        {t.items.map((item) => (
          <li class={`flex items-baseline gap-[10px] font-body text-sm leading-[1.4] before:font-semibold before:content-['✓'] ${t.featured ? 'text-white/90 before:text-white' : 'text-ink-2 before:text-accent'}`}>{item}</li>
        ))}
      </ul>
      <a href="/#kontakt" class={`mt-auto inline-flex h-[46px] items-center justify-center gap-2 rounded-[6px] border font-sans text-sm font-medium transition-colors ${
        t.featured
          ? 'border-white bg-white text-ink hover:bg-[#e9e9e9]'
          : 'border-line bg-[#f9f9f9] text-ink hover:border-line-2 hover:bg-[#eee]'
      }`}>{t.buyText}</a>
    </div>
  ))}
</div>
