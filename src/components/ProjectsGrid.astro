---
import PlaceholderImage from './PlaceholderImage.astro';

interface Project {
  title: string;
  sub: string;
  href: string;
  bg: string;
}
interface Props {
  tall: Project[];
  row: Project;
}
const { tall, row } = Astro.props;
---

<section id="projekty" class="wrap py-28">
  <div class="mb-16 flex items-end justify-between gap-6">
    <div>
      <p class="mb-4 font-body text-[12px] uppercase tracking-[0.12em] text-ink-3">projekty</p>
      <h2 class="reveal m-0 font-sans text-[clamp(36px,5vw,68px)] font-medium leading-[1.03] tracking-[-0.035em] text-ink">
        Podróże od wizji<br />
        <span class="font-serif font-normal italic">do ożywienia marki.</span>
      </h2>
    </div>
    <a href="/case-study" class="reveal delay-2 hidden shrink-0 items-center gap-2 self-end pb-2 font-body text-[13px] text-ink-3 underline-offset-4 hover:text-ink hover:underline transition-colors min-[761px]:flex">
      wszystkie projekty →
    </a>
  </div>

  <!-- main grid -->
  <div class="grid grid-cols-1 gap-5 min-[761px]:grid-cols-2">
    {tall.map((p, i) => (
      <a
        href={p.href}
        class={`reveal delay-${i + 1} project-card group block overflow-hidden rounded-[10px]`}
      >
        <div class="relative overflow-hidden" style={`background:${p.bg}`}>
          <PlaceholderImage
            label={`Grafika projektu — ${p.title}`}
            class="absolute inset-0 h-full w-full border-0 transition-transform duration-700 group-hover:scale-[1.03]"
            bg={p.bg}
          />
          <div class="relative aspect-[4/3]"></div>
        </div>
        <div class="flex items-start justify-between pt-5">
          <div>
            <div class="font-sans text-[20px] font-medium tracking-[-0.01em] text-ink">{p.title}</div>
            <div class="mt-1 font-body text-[12px] uppercase tracking-[0.08em] text-ink-3">{p.sub}</div>
          </div>
          <span class="mt-1 text-[18px] text-ink-3 transition-[transform,color] duration-300 group-hover:translate-x-[3px] group-hover:-translate-y-[3px] group-hover:text-ink">↗</span>
        </div>
      </a>
    ))}
  </div>

  <!-- bottom row: project + CTA card -->
  <div class="mt-5 grid grid-cols-1 gap-5 min-[761px]:grid-cols-2">
    <a href={row.href} class="reveal project-card group block overflow-hidden rounded-[10px]">
      <div class="relative overflow-hidden" style={`background:${row.bg}`}>
        <PlaceholderImage
          label={`Grafika projektu — ${row.title}`}
          class="absolute inset-0 h-full w-full border-0 transition-transform duration-700 group-hover:scale-[1.03]"
          bg={row.bg}
        />
        <div class="relative aspect-[4/3]"></div>
      </div>
      <div class="flex items-start justify-between pt-5">
        <div>
          <div class="font-sans text-[20px] font-medium tracking-[-0.01em] text-ink">{row.title}</div>
          <div class="mt-1 font-body text-[12px] uppercase tracking-[0.08em] text-ink-3">{row.sub}</div>
        </div>
        <span class="mt-1 text-[18px] text-ink-3 transition-[transform,color] duration-300 group-hover:translate-x-[3px] group-hover:-translate-y-[3px] group-hover:text-ink">↗</span>
      </div>
    </a>

    <!-- CTA dark card -->
    <div class="reveal delay-1 flex flex-col justify-between rounded-[10px] bg-dark p-9 min-h-[340px]">
      <div class="h-[6px] w-[6px] rounded-full bg-[#b48a78] shadow-[0_0_10px_rgba(180,138,120,0.7)]"></div>
      <div>
        <h3 class="m-0 font-sans text-[clamp(28px,3.5vw,44px)] font-medium leading-[1.05] tracking-[-0.025em] text-white">
          Dołącz do<br />zadowolonych<br />partnerów.
        </h3>
        <a href="#kontakt" class="mt-6 inline-flex items-center gap-2 border-b border-white/30 pb-1 font-sans text-[13px] text-white/70 transition-all hover:gap-3 hover:border-white hover:text-white">
          Umów konsultację <span>↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
