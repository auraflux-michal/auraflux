---
interface Props {
  quote: string;
  name: string;
  handle: string;
}
const { quote, name, handle } = Astro.props;
---

<section id="opinie" class="overflow-hidden border-y border-line py-28">
  <div class="wrap">
    <p class="mb-12 font-body text-[12px] uppercase tracking-[0.12em] text-ink-3">opinie</p>

    <!-- big quote -->
    <div class="reveal overflow-hidden">
      <blockquote class="m-0 font-serif text-[clamp(24px,3.8vw,52px)] font-normal italic leading-[1.25] tracking-[-0.015em] text-ink">
        „{quote}"
      </blockquote>
    </div>

    <!-- author -->
    <div class="reveal delay-2 mt-10 flex items-center gap-4">
      <div class="h-11 w-11 shrink-0 rounded-full bg-[linear-gradient(135deg,#8e7a65,#3b2e23)]"></div>
      <div>
        <b class="block font-sans text-[15px] font-semibold text-ink">{name}</b>
        <span class="font-body text-[12px] uppercase tracking-[0.08em] text-ink-3">{handle}</span>
      </div>
    </div>
  </div>
</section>
