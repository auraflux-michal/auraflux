---
interface Testimonial {
  quote: string;
  name: string;
  handle: string;
  role?: string;
}
interface Props {
  main: Testimonial;
}
const { main } = Astro.props;

const extras: Testimonial[] = [
  {
    quote: 'Profesjonalizm, terminowość i świetny efekt końcowy. Polecam każdemu, kto szuka agencji, która naprawdę słucha.',
    name: 'Anna Kowalska',
    handle: '@annakowalska',
    role: 'Founder, Studio AK',
  },
  {
    quote: 'Strona zbudowana przez auraflux działa jak maszyna sprzedażowa. Konwersja wzrosła o 40% w pierwszym miesiącu.',
    name: 'Marek Wiśniewski',
    handle: '@marekwisniewski',
    role: 'CEO, TechFlow',
  },
  {
    quote: 'Branding jest po prostu perfekcyjny. W końcu mam markę, z której jestem dumny.',
    name: 'Julia Nowak',
    handle: '@julianowak',
    role: 'Właścicielka, Lauro Home',
  },
];
---

<section id="opinie" class="py-28">
  <div class="wrap">
    <p class="mb-8 font-body text-[12px] uppercase tracking-[0.12em] text-ink-3">opinie</p>
    <h2 class="reveal mb-16 m-0 font-sans text-[clamp(40px,5.6vw,72px)] font-medium leading-[1.02] tracking-[-0.04em] text-ink">
      Głosy naszych<br /><span class="font-serif font-normal italic">partnerów.</span>
    </h2>

    <!-- main big quote -->
    <div class="reveal mb-8 rounded-[12px] bg-dark p-10 min-[981px]:p-14">
      <div class="mb-8 flex items-center gap-3">
        {[...Array(5)].map(() => <span class="text-[#b48a78] text-lg">★</span>)}
      </div>
      <blockquote class="m-0 font-serif text-[clamp(22px,3vw,38px)] italic leading-[1.3] tracking-[-0.01em] text-white">
        „{main.quote}"
      </blockquote>
      <div class="mt-8 flex items-center gap-3">
        <div class="h-10 w-10 rounded-full bg-[linear-gradient(135deg,#8e7a65,#3b2e23)]"></div>
        <div>
          <b class="block font-sans text-[14px] font-semibold text-white">{main.name}</b>
          <span class="font-body text-[12px] uppercase tracking-[0.08em] text-white/40">{main.handle}</span>
        </div>
      </div>
    </div>

    <!-- 3-col smaller cards -->
    <div class="grid grid-cols-1 gap-4 min-[761px]:grid-cols-3">
      {extras.map((t, i) => (
        <div class={`reveal delay-${i + 1} rounded-[12px] border border-line bg-canvas-2 p-7`}>
          <div class="mb-5 flex items-center gap-1">
            {[...Array(5)].map(() => <span class="text-[#b48a78] text-sm">★</span>)}
          </div>
          <blockquote class="m-0 font-body text-[14px] leading-[1.65] text-ink-2">„{t.quote}"</blockquote>
          <div class="mt-6 flex items-center gap-3">
            <div class="h-8 w-8 rounded-full bg-[linear-gradient(135deg,#c4a48a,#6e5240)]"></div>
            <div>
              <b class="block font-sans text-[13px] font-semibold text-ink">{t.name}</b>
              <span class="font-body text-[11px] uppercase tracking-[0.06em] text-ink-3">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
