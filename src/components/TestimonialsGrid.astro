---
interface Testimonial {
  quote: string;
  name: string;
  handle: string;
}
interface Props {
  main: Testimonial;
}
const { main } = Astro.props;

const extras = [
  { quote: 'Profesjonalizm na każdym kroku. Branding, który dostaliśmy, sprawił, że klienci sami pytają, kto to robił.', name: 'Anna K.', role: 'Founder, Studio AK', initials: 'AK' },
  { quote: 'Strona zbudowana przez auraflux działa jak maszyna sprzedażowa. Konwersja wzrosła o 40% w pierwszym miesiącu.', name: 'Marek W.', role: 'CEO, TechFlow', initials: 'MW' },
  { quote: 'W końcu mam markę, z której jestem dumny. Każdy detal przemyślany, każde słowo na miejscu.', name: 'Julia N.', role: 'Właścicielka, Lauro Home', initials: 'JN' },
  { quote: 'Praca z auraflux to czysta przyjemność. Terminowo, bez chaosu, z prawdziwym zaangażowaniem.', name: 'Piotr M.', role: 'Dyrektor, Nord Digital', initials: 'PM' },
];
---

<section id="opinie" class="py-28 border-b border-line">
  <div class="wrap">
    <div class="mb-14 flex items-end justify-between gap-8">
      <div>
        <p class="mb-5 font-body text-[12px] uppercase tracking-[0.12em] text-ink-3">opinie</p>
        <h2 class="reveal m-0 font-sans text-[clamp(40px,5.2vw,68px)] font-medium leading-[1.02] tracking-[-0.04em] text-ink">
          Głosy naszych<br /><span class="font-serif font-normal italic">partnerów.</span>
        </h2>
      </div>
      <div class="reveal delay-2 hidden shrink-0 items-center gap-1 self-end pb-2 min-[761px]:flex">
        {[...Array(5)].map(() => <span class="text-[#b48a78] text-xl">★</span>)}
        <span class="ml-2 font-body text-[13px] text-ink-3">5.0 / 5.0</span>
      </div>
    </div>

    <!-- large main testimonial -->
    <div class="reveal mb-5 grid gap-5 min-[981px]:grid-cols-[1.4fr_1fr]">
      <div class="rounded-[14px] bg-dark p-10 min-[981px]:p-12">
        <div class="mb-6 flex gap-1">
          {[...Array(5)].map(() => <span class="text-[#b48a78] text-lg">★</span>)}
        </div>
        <blockquote class="m-0 font-serif text-[clamp(20px,2.6vw,32px)] italic leading-[1.35] text-white">
          „{main.quote}"
        </blockquote>
        <div class="mt-8 flex items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-[linear-gradient(135deg,#8e7a65,#3b2e23)] flex items-center justify-center font-sans text-[11px] font-semibold text-white">
            {main.name.split(' ').map((w: string) => w[0]).join('')}
          </div>
          <div>
            <b class="block font-sans text-[14px] font-semibold text-white">{main.name}</b>
            <span class="font-body text-[12px] text-white/40">{main.handle}</span>
          </div>
        </div>
      </div>

      <!-- side: 2 stacked small cards -->
      <div class="flex flex-col gap-5">
        {extras.slice(0, 2).map((t, i) => (
          <div class={`reveal delay-${i + 1} flex flex-1 flex-col justify-between rounded-[14px] border border-line bg-canvas-2 p-7`}>
            <div>
              <div class="mb-4 flex gap-1">
                {[...Array(5)].map(() => <span class="text-[#b48a78] text-sm">★</span>)}
              </div>
              <blockquote class="m-0 font-body text-[14px] leading-[1.65] text-ink-2">„{t.quote}"</blockquote>
            </div>
            <div class="mt-5 flex items-center gap-3">
              <div class="h-8 w-8 rounded-full bg-[linear-gradient(135deg,#c4a48a,#6e5240)] flex items-center justify-center font-sans text-[10px] font-semibold text-white">{t.initials}</div>
              <div>
                <b class="block font-sans text-[13px] font-semibold text-ink">{t.name}</b>
                <span class="font-body text-[11px] text-ink-3">{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- bottom row: 2 more cards -->
    <div class="grid gap-5 min-[761px]:grid-cols-2">
      {extras.slice(2).map((t, i) => (
        <div class={`reveal delay-${i + 1} rounded-[14px] border border-line bg-canvas-2 p-7`}>
          <div class="mb-4 flex gap-1">
            {[...Array(5)].map(() => <span class="text-[#b48a78] text-sm">★</span>)}
          </div>
          <blockquote class="m-0 font-body text-[15px] leading-[1.65] text-ink-2">„{t.quote}"</blockquote>
          <div class="mt-5 flex items-center gap-3">
            <div class="h-8 w-8 rounded-full bg-[linear-gradient(135deg,#9a8a78,#4a3e34)] flex items-center justify-center font-sans text-[10px] font-semibold text-white">{t.initials}</div>
            <div>
              <b class="block font-sans text-[13px] font-semibold text-ink">{t.name}</b>
              <span class="font-body text-[11px] text-ink-3">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
