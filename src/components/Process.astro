---
const steps = [
  { num: '01', name: 'Odkrycie', desc: 'Brief, analiza rynku i konkurencji, mapowanie person. Poznajemy Cię i Twój cel przed jakimkolwiek działaniem.', tag: 'Discovery' },
  { num: '02', name: 'Strategia', desc: 'DNA marki, pozycjonowanie, ton komunikacji. Fundament, na którym wszystko inne ma sens i kierunek.', tag: 'Strategy' },
  { num: '03', name: 'Design & Build', desc: 'Identyfikacja wizualna, strona, treści. Budujemy bez szablonów — każdy projekt inny, każdy przemyślany.', tag: 'Design & Build' },
  { num: '04', name: 'Launch & Wzrost', desc: 'Wdrożenie, testy, monitoring. Opieka techniczna i marketing — żebyś rósł bez zakłóceń.', tag: 'Launch & Growth' },
];
---

<section class="bg-dark py-28">
  <div class="wrap">
    <div class="mb-16 grid items-end gap-8 min-[981px]:grid-cols-[1fr_1fr]">
      <div>
        <p class="mb-6 font-body text-[12px] uppercase tracking-[0.12em] text-white/30">proces</p>
        <h2 class="reveal m-0 font-sans text-[clamp(40px,5.2vw,68px)] font-medium leading-[1.02] tracking-[-0.04em] text-white">
          Proces stworzony<br />dla szybkości<br /><span class="font-serif font-normal italic text-white/55">i precyzji.</span>
        </h2>
      </div>
      <p class="reveal delay-2 self-end max-w-[340px] font-body text-[15px] leading-[1.65] text-white/40">
        Od pierwszej rozmowy do live — wiemy co robimy i kiedy. Żadnych niespodzianek, tylko konkretny plan i terminowe wdrożenie.
      </p>
    </div>

    <!-- horizontal rows: left = step info, right = visual card -->
    <div class="border-t border-white/[0.07]">
      {steps.map((s, i) => (
        <div class={`reveal delay-${i} grid items-center gap-8 border-b border-white/[0.07] py-8 min-[761px]:grid-cols-[1fr_220px]`}>
          <!-- left -->
          <div class="flex items-start gap-8 min-[761px]:gap-12">
            <span class="shrink-0 pt-1 font-body text-[11px] uppercase tracking-[0.12em] text-white/20">{s.num}</span>
            <div>
              <div class="font-sans text-[22px] font-medium leading-[1.1] tracking-[-0.02em] text-white min-[981px]:text-[26px]">{s.name}</div>
              <p class="mt-2 max-w-[500px] font-body text-[14px] leading-[1.65] text-white/40">{s.desc}</p>
            </div>
          </div>
          <!-- right: dark pill-card -->
          <div class="hidden min-[761px]:flex items-center justify-center rounded-[10px] border border-white/[0.08] bg-white/[0.04] py-4 px-5 backdrop-blur-sm">
            <span class="font-body text-[12px] uppercase tracking-[0.1em] text-white/30">{s.tag}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
