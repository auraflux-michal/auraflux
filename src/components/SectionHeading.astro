---
interface Props {
  eyebrow: string;
}
const { eyebrow } = Astro.props;
---

<p class="mb-6 font-body text-[13px] text-ink-3">{eyebrow}</p>
<h2 class="m-0 font-sans text-[clamp(40px,5.6vw,76px)] font-medium leading-[1.02] tracking-[-0.035em] text-ink [&_.it]:font-serif [&_.it]:font-normal [&_.it]:italic [&_.it]:tracking-[-0.01em]">
  <slot />
</h2>
