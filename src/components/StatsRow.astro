---
interface Stat {
  n: string;
  l: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<div class="grid grid-cols-1 gap-8 border-y border-line py-[46px] min-[561px]:grid-cols-2 min-[981px]:grid-cols-4 min-[981px]:gap-7">
  {stats.map((s) => (
    <div>
      <div class="font-sans text-[clamp(38px,5vw,60px)] font-medium leading-none tracking-[-0.03em] text-ink">{s.n}</div>
      <div class="mt-3 max-w-[200px] font-body text-sm text-ink-3">{s.l}</div>
    </div>
  ))}
</div>
